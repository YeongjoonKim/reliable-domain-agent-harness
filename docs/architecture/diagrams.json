              "Versioned observations"
            ]
          },
          {
            "title": "Verify claims",
            "lines": [
              "Need relevance",
              "Span / hash / value"
            ]
          }
        ],
        "serial": true
      },
      {
        "title": "DECISION AT THE ATTEMPT BOUNDARY",
        "nodes": [
          {
            "title": "Accept",
            "lines": [
              "All requested claims pass",
              "Return supported result"
            ]
          },
          {
            "title": "Reflect + retry",
            "lines": [
              "Rejected / failed attempt",
              "Use declared next attempt"
            ]
          },
          {
            "title": "Abstain",
            "lines": [
              "No supported result",
              "Budget / attempts exhausted"
            ]
          },
          {
            "title": "Cancel",
            "lines": [
              "Cancellation recorded",
              "Tool deadline / cleanup"
            ]
          }
        ],
        "serial": false
      }
    ],
    "note": "Retry uses predeclared alternatives within the original budget. No hidden planner or learning update."
